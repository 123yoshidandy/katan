{
  "name": "katan",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:server": "esbuild server/src/handler.js --bundle --platform=node --format=esm --target=node22 --external:@aws-sdk/* --outfile=server/dist/handler.mjs",
    "dev:server": "node server/dev-server.js",
    "deploy:server": "npm run build:server && cd server && sam deploy"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
